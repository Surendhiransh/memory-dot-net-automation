# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# Secrets / local config
kingston_scraper/.env

# Runtime state (cookies, resume/status bookkeeping) -- not source, not data to ship
kingston_scraper/state/*.json

# Logs
kingston_scraper/logs/
kingston_scraper/audit_full_run.log

# Debug snapshots of blocked pages -- transient troubleshooting artifacts, not deliverable data
kingston_scraper/output/debug/
kingston_scraper/output/.~lock.*

# Redundant raw archive of the already-extracted kingston_scraper/ project
kingston_scraper.zip
kingston_scraper/output/kingston_test_5.zip

# Superseded ad-hoc verification tool (see README note) -- kept locally, not part of this repo
/verification/
/verify_kingston_csv.py
/output/
# Local Playwright profile (cookies, cache, browser state)
kingston_scraper/state/browser_profile/
kingston_scraper/state/manual_*_profile/

# Hpe/spec_verifier -- source data and generated reports (data privacy, not deliverable)
Hpe/spec_verifier/*.csv
Hpe/spec_verifier/verification_report_*.html
Hpe/spec_verifier/verification_log.txt
Hpe/spec_verifier/*_output.txt
Hpe/spec_verifier/*_ANALYSIS.txt

# Gigaipc -- generated catalog/report CSVs are run output, not source
Gigaipc/*.csv
Gigaipc/output/
Gigaipc/gigabyte_enterprise_products/*.csv
Gigaipc/gigabyte_enterprise_products/*.xlsx

# Hpe / kingston_scraper -- generated run output, not source
Hpe/output/
kingston_scraper/output/

# Oracle -- source data and generated reports (data privacy, not deliverable)
Oracle/oracle_host_memory_specification*.csv
Oracle/output/
Oracle/ci-output/
Oracle/tests/Oracle_Memory_Spec_Test_Cases.xlsx
